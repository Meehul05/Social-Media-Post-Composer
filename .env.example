# ============================================================================
# Post Composer — Social Media Studio (.env.example)
# Copy to .env and supply real secrets before running in production.
# ============================================================================

# Frontend Configuration (Vite)
VITE_API_BASE_URL=/api/v1

# Server & Deployment
SERVER_PORT=8080
DEPLOYMENT_TRACK=stable
APP_VERSION=1.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MySQL 8 Database
MYSQL_DATABASE=post_composer
MYSQL_USER=postcomposer
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/post_composer?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=postcomposer
SPRING_DATASOURCE_PASSWORD=replace_with_mysql_password

# Apache Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=post-composer-publishing-group

# Security: JWT & AES-256-GCM Credential Encryption
JWT_SECRET=replace_with_base64_encoded_256_bit_jwt_secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
AES_GCM_KEY_BASE64=replace_with_base64_encoded_32_byte_aes_gcm_key

# Social Media Platform Integrations
# Set PLATFORM_SANDBOX_MODE=false in production when valid OAuth credentials are configured
PLATFORM_SANDBOX_MODE=true
INSTAGRAM_CLIENT_ID=your_instagram_meta_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_meta_app_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Media Storage
MEDIA_UPLOAD_DIR=./uploads

# AI Caption Assistant (Server-side only — never exposed to browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
